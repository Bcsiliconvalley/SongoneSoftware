# Copia este archivo como .streamlit/secrets.toml y ajusta tus datos.
# secrets.toml NUNCA se sube a GitHub (está en .gitignore).

[mysql]
host = "127.0.0.1"
port = 3306
user = "root"
password = "root"          # MAMP usa "root" por defecto
database = "someone_somewhere"

[auth]
# Clave para firmar la cookie de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_key = "CAMBIA-ESTO-POR-UNA-CADENA-LARGA-Y-ALEATORIA"
